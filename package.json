{
  "name": "flouna-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"server,web\" -c \"cyan,magenta\" \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "build:all": "npm run build -w server && npm run build -w web",
    "build:server": "npm run build -w server",
    "build:web": "npm run build -w web",
    "start": "npm run start -w web",
    "test": "npm test -w server",
    "seed": "npm run seed -w server",
    "prisma:studio": "npm run prisma:studio -w server",
    "lint": "npm run lint -w web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
