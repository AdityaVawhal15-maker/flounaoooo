# Copy to .env and fill in values. Never commit .env.

NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
WEB_ORIGIN=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth (https://console.cloud.google.com → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for email OTP — leave empty in dev (codes print to console)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Radiues <no-reply@radiues.app>"

# LLM: anthropic | deepseek | demo (no key needed for demo)
LLM_PROVIDER=demo
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Cashfree (sandbox keys from https://merchant.cashfree.com)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Maps
MAPTILER_KEY=
GEOAPIFY_KEY=
ORS_KEY=
